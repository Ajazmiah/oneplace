{
  "manifest_version": 3,
  "name": "JobLog",
  "version": "0.1.0",
  "description": "Extension- form to upload resume & cover letter",
  "action": {
    "default_title": "Click to change background"
  },
  "permissions": ["storage", "tabs", "scripting","activeTab"],
  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["contentScript.js"],
      "css": ["contentScript.css"]
    }
  ]
}
