{
  "manifest_version": 3,
  "host_permissions": ["http://localhost:3000/*"],
  "name": "OnePlace",
  "version": "0.1.0",
  "description": "Track your job applications directly from your browser.",
  "action": {
    "default_title": "OneTrack"
  },
  "permissions": ["storage", "activeTab", "tabs", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.glassdoor.com/*",
        "https://*.ziprecruiter.com/*",
        "https://*.monster.com/*",
        "https://*.wellfound.com/*",
        "https://*.dice.com/*",
        "https://*.simplyhired.com/*",
        "https://*.smartrecruiters.com/*"
      ],
      "js": ["content-scripts/job-scraper.js"]
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*"]
  },
  "key": ""
}
